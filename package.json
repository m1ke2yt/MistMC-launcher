{
  "name": "mistmc-launcher",
  "productName": "Mist MC Launcher",
  "version": "1.5.2",
  "description": "Mist MC Launcher - Minecraft 1.21.11 (mistmc.gg)",
  "author": "Mist MC",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "fetch-jre": "node scripts/fetch-jre.mjs",
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "postinstall": "electron-builder install-app-deps || true"
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.3.0",
    "@xmcl/core": "2.15.1",
    "@xmcl/installer": "6.1.2",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "gg.mistmc.launcher",
    "productName": "Mist MC Launcher",
    "artifactName": "MistMC-Launcher-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "afterAllArtifactBuild": "build/checksums.js",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "resources/jre-win",
          "to": "jre",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "resources/mods",
          "to": "mods",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Game",
      "extraResources": [
        {
          "from": "resources/jre-linux",
          "to": "jre",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "resources/mods",
          "to": "mods",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mist MC Launcher"
    },
    "compression": "maximum",
    "publish": [
      {
        "provider": "generic",
        "url": "https://mistmc.gg/downloads/"
      }
    ]
  }
}
